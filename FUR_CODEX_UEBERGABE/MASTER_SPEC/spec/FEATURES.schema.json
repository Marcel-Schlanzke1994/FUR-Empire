{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fur-empire.local/spec/features.schema.json",
  "type": "object",
  "required": [
    "spec_version",
    "features",
    "total"
  ],
  "properties": {
    "spec_version": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "title",
          "origin",
          "priority",
          "status",
          "acceptance",
          "behavior_contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]{3}$|^[A-Z][0-9]{2}$"
          },
          "group": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "origin": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "status": {
            "enum": [
              "not_verified",
              "in_progress",
              "implemented",
              "verified",
              "blocked_external"
            ]
          },
          "acceptance": {
            "type": "array",
            "minItems": 3
          },
          "behavior_contract": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
